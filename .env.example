# Copy to .env and edit as needed. All values have sensible defaults.

PROJECT_NAME=ros-reductstore-demo
NETWORK_NAME=reductnet

# Container images
REDUCT_IMAGE=reduct/store:latest
GRAFANA_IMAGE=grafana/grafana:latest
FOXGLOVE_IMAGE=ghcr.io/foxglove/studio:latest

# Grafana ReductStore datasource plugin
GRAFANA_REDUCT_TAG=v1.1.0
GRAFANA_REDUCT_VERSION=1.1.0

# Tokens (demo values; change for anything but local use)
CLOUD_API_TOKEN=cloud
EDGE_API_TOKEN=edge
GRAFANA_READ_TOKEN=grafana

# Host path to a ReductStore license file (required for some Pro features).
# Place a valid reduct.lic here or point to your own path.
HOST_LICENSE_PATH=./licenses/reduct.lic
